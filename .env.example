# AI gateway environment. Copy to .env and fill in real values. Never commit .env.

# --- Gateway access (REQUIRED) ----------------------------------------------------------
# Callers send this in `x-api-key` (or `Authorization: Bearer`). If it is empty the gateway
# FAILS CLOSED: every route except GET /health answers 503.
# Comma-separate several keys to rotate without downtime: AI_PROCESSOR_API_KEY=old,new
AI_PROCESSOR_API_KEY=generate-a-long-random-secret

# --- Provider keys (set the ones you want in the fallback chain) ------------------------
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Routing -----------------------------------------------------------------------------
AI_DEFAULT_MODEL=gpt-6-luna
AI_REASONING_EFFORT=none
# Per provider attempt, and the longest one request may spend walking the fallback chain.
AI_REQUEST_TIMEOUT_MS=90000
AI_TOTAL_BUDGET_MS=120000
# Circuit breaker: this many provider-side failures in a row skip that provider for the cooldown.
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000

# --- Gateway limits and exposure ---------------------------------------------------------
# Requests per minute per API key on /v1/chat/completions.
GATEWAY_RATE_PER_MIN=120
# Failed authentication attempts per minute per client address before it is locked out.
GATEWAY_AUTH_FAILS_PER_MIN=10
# Server-to-server service: no CORS headers unless origins are listed (comma separated).
GATEWAY_CORS_ORIGINS=
# true when a reverse proxy (nginx/Caddy) is in front, so limits see the real client address.
GATEWAY_TRUST_PROXY=false
# true = callers may name any model (default: only catalogued models, so cost stays predictable)
GATEWAY_ALLOW_ANY_MODEL=false

# --- Server ------------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
