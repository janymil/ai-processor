{
  "apps": [{
    "name": "ai-processor",
    "script": "npx tsx index.ts",
    "cwd": "/home/coder/ai-processor",
    "instances": 1,
    "exec_mode": "fork",
    "watch": false,
    "max_memory_restart": "512M",
    "env": {
      "NODE_ENV": "production",
      "PORT": "8080",
      "HOST": "0.0.0.0"
    },
    "error_file": "./logs/err.log",
    "out_file": "./logs/out.log",
    "log_file": "./logs/combined.log",
    "time": true,
    "autorestart": true,
    "max_restarts": 10,
    "min_uptime": "10s"
  }]
}
